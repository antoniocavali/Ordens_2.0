# ─── Copie para .env e ajuste. NUNCA commite o .env real. ───

NODE_ENV=development
LOG_LEVEL=debug

# Portas expostas no host (ajuste se já estiverem em uso)
POSTGRES_HOST_PORT=5452
REDIS_HOST_PORT=6399
MINIO_HOST_PORT=9020
MINIO_CONSOLE_HOST_PORT=9021
MAILPIT_UI_HOST_PORT=8035
MAILPIT_SMTP_HOST_PORT=1035
API_HOST_PORT=4000
WEB_HOST_PORT=3020

# PostgreSQL (bootstrap do container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ordens
ORDENS_OWNER_PASSWORD=change-me-owner
ORDENS_APP_PASSWORD=change-me-app

# Migrations usam ordens_owner; runtime usa ordens_app (sem BYPASSRLS)
MIGRATION_DATABASE_URL=postgresql://ordens_owner:change-me-owner@postgres:5432/ordens
DATABASE_URL=postgresql://ordens_app:change-me-app@postgres:5432/ordens
DATABASE_POOL_MAX=20

# Redis
REDIS_URL=redis://redis:6379

# Object storage (MinIO local / S3 em produção)
S3_ENDPOINT=http://minio:9000
# Endpoint usado nas URLs pré-assinadas entregues ao navegador
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ordens-minio
S3_SECRET_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_QUARANTINE=ordens-quarantine
S3_BUCKET_DOCUMENTS=ordens-documents
UPLOAD_MAX_BYTES=2147483648
# noop (apenas dev) | clamav
SCANNER=noop
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
TWO_FACTOR_ENC_KEY=
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
COOKIE_SECURE=false

# E-mail (Mailpit local)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="Ordens <nao-responda@ordens.local>"

# Web
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_APP_NAME=Ordens

# Seed de demonstração (somente desenvolvimento)
SEED_DEMO=true
# Se vazio, uma senha aleatória é gerada e exibida uma única vez em `docker compose logs migrate`
SEED_DEMO_PASSWORD=
