  @@index([tenantId, farmId])
  @@index([tenantId, buyerPartnerId])
  @@index([tenantId, commodityId])
  @@index([tenantId, contractId])
  @@index([tenantId, sellerOrgId])
  @@index([tenantId, buyerOrgId])
  @@index([tenantId, updatedAt(sort: Desc)])
