  returnedBy         String?        @map("returned_by") @db.Uuid
  returnReason       String?        @map("return_reason")
  cancelledAt        DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy        String?        @map("cancelled_by") @db.Uuid
  cancelReason       String?        @map("cancel_reason")
  suspendedAt        DateTime?      @map("suspended_at") @db.Timestamptz(6)
  suspendedBy        String?        @map("suspended_by") @db.Uuid
  suspendReason      String?        @map("suspend_reason")
  lastMaterialChangeAt DateTime?    @map("last_material_change_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?        @map("created_by") @db.Uuid
  updatedBy          String?        @map("updated_by") @db.Uuid

