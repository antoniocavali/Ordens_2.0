model Invoice {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  loadId             String        @map("load_id") @db.Uuid
  orderId            String        @map("order_id") @db.Uuid
  sellerOrgId        String?       @map("seller_org_id") @db.Uuid
  buyerOrgId         String?       @map("buyer_org_id") @db.Uuid
  fileUploadId       String?       @unique @map("file_upload_id") @db.Uuid
  origin             InvoiceOrigin
  status             InvoiceStatus @default(VALID)
  accessKey          String?       @map("access_key") @db.Char(44)
  number             String?
  series             String?
  issuedAt           DateTime?     @map("issued_at") @db.Timestamptz(6)
  issuerDocument     String?       @map("issuer_document")
  issuerName         String?       @map("issuer_name")
  recipientDocument  String?       @map("recipient_document")
  recipientName      String?       @map("recipient_name")
  totalValue         Decimal?      @map("total_value") @db.Decimal(18, 2)
  netWeightKg        Decimal?      @map("net_weight_kg") @db.Decimal(18, 4)
  grossWeightKg      Decimal?      @map("gross_weight_kg") @db.Decimal(18, 4)
  quantity           Decimal?      @db.Decimal(18, 4)
  quantityUnit       String?       @map("quantity_unit")
  productDescription String?       @map("product_description")
  plate              String?
  protocolStatus     String?       @map("protocol_status")
  divergences        Json          @default("[]")
  rejectReason       String?       @map("reject_reason")
  cancelReason       String?       @map("cancel_reason")
  /// Cópia do XML da Fazenda na pasta de rede da empresa.
  archivedAt         DateTime?     @map("archived_at") @db.Timestamptz(6)
  archivePath        String?       @map("archive_path")
  archiveError       String?       @map("archive_error")
  archiveAttempts    Int           @default(0) @map("archive_attempts")
  createdBy          String?       @map("created_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, loadId])
  @@index([tenantId, status])
  @@map("invoices")
}

model Occurrence {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  orderId           String             @map("order_id") @db.Uuid
  loadId            String?            @map("load_id") @db.Uuid
  sellerOrgId       String?            @map("seller_org_id") @db.Uuid
  buyerOrgId        String?            @map("buyer_org_id") @db.Uuid
  number            String
  type              OccurrenceType
  severity          OccurrenceSeverity @default(MEDIUM)
  status            OccurrenceStatus   @default(OPEN)
  title             String
  description       String?
  visibility        DocumentVisibility @default(INTERNAL)
  responsibleUserId String?            @map("responsible_user_id") @db.Uuid
  dueOn             DateTime?          @map("due_on") @db.Date
  resolution        String?
  resolvedAt        DateTime?          @map("resolved_at") @db.Timestamptz(6)
  resolvedBy        String?            @map("resolved_by") @db.Uuid
  source            String             @default("MANUAL")
  createdBy         String?            @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, orderId])
  @@index([tenantId, loadId])
  @@map("occurrences")
}

model LoadingOrderView {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  side           Scope
  userId         String   @map("user_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  version        Int
  firstViewedAt  DateTime @default(now()) @map("first_viewed_at") @db.Timestamptz(6)
  lastViewedAt   DateTime @default(now()) @map("last_viewed_at") @db.Timestamptz(6)
  viewCount      Int      @default(1) @map("view_count")
  lastIp         String?  @map("last_ip") @db.Inet
  lastUserAgent  String?  @map("last_user_agent")
  lastSessionId  String?  @map("last_session_id") @db.Uuid
  correlationId  String?  @map("correlation_id")

  order LoadingOrder @relation(fields: [orderId], references: [id])

  @@unique([orderId, organizationId, userId, version])
  @@index([tenantId, orderId, side, version])
  @@map("loading_order_views")
}

/// Exportação de relatório em segundo plano (ver migration 20260925002300_report_jobs).
model ReportJob {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  requestedBy  String    @map("requested_by") @db.Uuid
  kind         String
  format       String
  params       Json      @default("{}")
  status       String    @default("PENDING")
  rows         Int?
  total        Int?
  truncated    Boolean   @default(false)
  bucket       String?
  objectKey    String?   @map("object_key")
  sizeBytes    BigInt?   @map("size_bytes")
  error        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)

  @@index([tenantId, requestedBy, createdAt(sort: Desc)], map: "report_jobs_user_recent")
  @@map("report_jobs")
}

/// Cópia do XML da Fazenda em pasta de rede (uma configuração por empresa).
model XmlArchiveSettings {
  tenantId        String    @id @map("tenant_id") @db.Uuid
  enabled         Boolean   @default(false)
  path            String    @default("")
  domain          String?
  username        String?
  passwordEnc     Bytes?    @map("password_enc")
  folderTemplate  String    @default("{ano}\\{mes}") @map("folder_template")
  lastTestAt      DateTime? @map("last_test_at") @db.Timestamptz(6)
  lastTestOk      Boolean?  @map("last_test_ok")
  lastTestMessage String?   @map("last_test_message")
  updatedBy       String?   @map("updated_by") @db.Uuid
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("xml_archive_settings")
}
