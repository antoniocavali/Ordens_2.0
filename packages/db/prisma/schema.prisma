// Schema principal. RLS, grants, triggers e índices especiais ficam em migrations SQL
// (ver prisma/migrations/*_security). Documentação: docs/data-model.md

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED

  @@map("tenant_status")
}

enum Scope {
  PLATFORM
  MATRIZ
  FARM
  BUYER
  CARRIER

  @@map("scope_type")
}

enum OrgKind {
  MATRIZ
  FARM
  BUYER
  CARRIER

  @@map("org_kind")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("record_status")
}

enum SessionStage {
  PENDING_2FA
  PENDING_2FA_SETUP
  PENDING_PASSWORD_CHANGE
  ACTIVE

  @@map("session_stage")
}

enum LoginResult {
  SUCCESS
  INVALID_CREDENTIALS
  LOCKED
  TWO_FACTOR_FAILED
  TWO_FACTOR_SUCCESS
  INACTIVE
  PASSKEY_SUCCESS
  PASSKEY_FAILED

  @@map("login_result")
}

enum PartnerRole {
  BUYER
  SELLER
  PRODUCER
  COOPERATIVE_MEMBER
  COOPERATIVE
  CARRIER
  OTHER

  @@map("partner_role")
}

enum PersonType {
  PF
  PJ

  @@map("person_type")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED

  @@map("contract_status")
}

enum FreightMode {
  CIF
  FOB
  THIRD_PARTY
  TO_DEFINE

  @@map("freight_mode")
}

enum OrderStatus {
  DRAFT
  PENDING_BILLING
  PUBLISHED
  IN_PROGRESS
  SUSPENDED
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("order_priority")
}

enum OperationType {
  PURCHASE
  SALE
  TRANSFER
  STORAGE

  @@map("operation_type")
}

enum ReleaseStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  CANCELLED

  @@map("release_status")
}

enum OrderOrigin {
  MATRIZ
  BUYER

  @@map("order_origin")
}

enum UploadStatus {
  PENDING
  UPLOADING
  UPLOADED
  PROCESSING
  AVAILABLE
  REJECTED
  INFECTED
  ABORTED
  EXPIRED

  @@map("upload_status")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
  SKIPPED_DEV

  @@map("scan_status")
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  CONVERTED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum LoadStatus {
  SCHEDULED
  CONFIRMED
  AWAITING_LOADING
  LOADING
  AWAITING_FARM_INVOICE
  FARM_INVOICED
  LOADED
  IN_TRANSIT
  ARRIVED
  RECEIVED
  CHECKED
  AWAITING_MATRIZ_INVOICE
  MATRIZ_INVOICED
  COMPLETED
  CANCELLED

  @@map("load_status")
}

enum VehicleType {
  TRUCK_TRACTOR
  TRAILER
  SEMI_TRAILER
  BITRAIN
  ROAD_TRAIN
  TRUCK
  OTHER

  @@map("vehicle_type")
}

enum DocumentKind {
  NFE_XML
  PDF
  IMAGE
  SPREADSHEET
  OTHER

  @@map("document_kind")
}

// ─────────────────────── Tenancy e identidade ───────────────────────

model Tenant {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String       @unique
  name            String
  status          TenantStatus @default(ACTIVE)
  require2fa      Boolean      @default(false) @map("require_2fa")
  require2faRoles String[]     @default([]) @map("require_2fa_roles")
  viewSlaHours    Int          @default(24) @map("view_sla_hours")
  /// Dupla checagem na publicação (Q40): quem publica não pode ser quem editou por último.
  publishFourEyes     Boolean  @default(false) @map("publish_four_eyes")
  /// Aplica a dupla checagem só a ordens com pelo menos esta quantidade (toneladas). Nulo = todas.
  publishFourEyesMinT Decimal? @map("publish_four_eyes_min_t") @db.Decimal(18, 3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations Organization[]
  memberships   Membership[]

  @@map("tenants")
}

model Organization {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  kind      OrgKind
  name      String
  partnerId String?      @map("partner_id") @db.Uuid
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  partner     BusinessPartner? @relation(fields: [partnerId], references: [id])
  memberships Membership[]
  farms       Farm[]

  @@index([tenantId, kind])
  @@index([tenantId, partnerId])
  @@map("organizations")
}

model User {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String       @unique
  name             String
  passwordHash     String?      @map("password_hash")
  securityVersion  Int          @default(1) @map("security_version")
  failedLoginCount Int          @default(0) @map("failed_login_count")
  lockedUntil      DateTime?    @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime?    @map("last_login_at") @db.Timestamptz(6)
  isPlatformAdmin  Boolean      @default(false) @map("is_platform_admin")
  /// Espelho de two_factor_credentials.confirmed_at, legível por administradores (credenciais ficam sob RLS do próprio usuário).
  twoFactorEnabled Boolean      @default(false) @map("two_factor_enabled")
  /// Senha provisória definida por administrador: troca obrigatória no próximo acesso.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         Membership[]
  sessions            Session[]
  twoFactorCredential TwoFactorCredential?
  recoveryCodes       RecoveryCode[]
  webauthnCredentials WebauthnCredential[]
  passwordResetTokens PasswordResetToken[]
  preference          UserPreference?

  @@map("users")
}

model Membership {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  scope          Scope
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  roles        MembershipRole[]
  supportQueues SupportQueueMember[]
  customRoles   MembershipCustomRole[]
  permissionGrants MembershipPermissionGrant[]

  @@unique([userId, organizationId])
  @@index([tenantId, organizationId])
  @@map("memberships")
}

/// Filas do atendimento de cada atendente (Q31). Supervisão atende todas sem linha aqui.
model SupportQueueMember {
  tenantId     String       @map("tenant_id") @db.Uuid
  membershipId String       @map("membership_id") @db.Uuid
  queue        SupportQueue
  createdBy    String?      @map("created_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, queue])
  @@index([tenantId, queue])
  @@map("support_queue_members")
}

model Role {
  code        String           @id
  name        String
  scope       Scope
  permissions RolePermission[]
  memberships MembershipRole[]

  @@map("roles")
}

enum CustomRoleStatus {
  ACTIVE
  ARCHIVED

  @@map("custom_role_status")
}

/// Papel personalizado do tenant (Q35). Papéis do sistema ficam em `roles` (catálogo fixo).
model TenantRole {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String
  description String?
  scope       Scope
  status      CustomRoleStatus @default(ACTIVE)
  createdBy   String?          @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions TenantRolePermission[]
  memberships MembershipCustomRole[]

  @@index([tenantId, scope])
  @@map("tenant_roles")
}

model TenantRolePermission {
  roleId         String @map("role_id") @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
  @@map("tenant_role_permissions")
}

model MembershipCustomRole {
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       TenantRole @relation(fields: [roleId], references: [id])

  @@id([membershipId, roleId])
  @@index([tenantId, roleId])
  @@map("membership_custom_roles")
}

/// Permissão concedida individualmente a um acesso da Matriz (Q34).
model MembershipPermissionGrant {
  membershipId   String   @map("membership_id") @db.Uuid
  permissionCode String   @map("permission_code")
  tenantId       String   @map("tenant_id") @db.Uuid
  grantedBy      String?  @map("granted_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code])

  @@id([membershipId, permissionCode])
  @@index([tenantId])
  @@map("membership_permission_grants")
}

model Permission {
  code        String           @id
  description String
  roles       RolePermission[]
  tenantRoles TenantRolePermission[]
  grants      MembershipPermissionGrant[]

  @@map("permissions")
}

model RolePermission {
  roleCode       String @map("role_code")
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String   @map("membership_id") @db.Uuid
  roleCode     String   @map("role_code")
  tenantId     String   @map("tenant_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleCode], references: [code])

  @@id([membershipId, roleCode])
  @@index([tenantId])
  @@map("membership_roles")
}

model Session {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash          Bytes        @unique @map("token_hash")
  userId             String       @map("user_id") @db.Uuid
  activeMembershipId String?      @map("active_membership_id") @db.Uuid
  securityVersion    Int          @map("security_version")
  stage              SessionStage
  ip                 String?      @db.Inet
  userAgent          String?      @map("user_agent")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt         DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt      DateTime     @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt  DateTime     @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt          DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedReason      String?      @map("revoked_reason")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@map("sessions")
}

model LoginAttempt {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  email     String
  result    LoginResult
  ip        String?     @db.Inet
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@map("login_attempts")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

model TwoFactorCredential {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  secretEnc    Bytes     @map("secret_enc")
  keyVersion   Int       @default(1) @map("key_version")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  lastTimeStep BigInt?   @map("last_time_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("two_factor_credentials")
}

model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("recovery_codes")
}

/// Reservado para Passkeys/WebAuthn (fase futura).
model WebauthnCredential {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  credentialId Bytes     @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  signCount    BigInt    @default(0) @map("sign_count")
  transports   String[]  @default([])
  name         String
  /// Passkey sincronizada entre aparelhos (iCloud, Google, gerenciador de senhas).
  backedUp     Boolean   @default(false) @map("backed_up")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("webauthn_credentials")
}

model UserPreference {
  userId           String   @id @map("user_id") @db.Uuid
  theme            String   @default("system")
  sidebarCollapsed Boolean  @default(false) @map("sidebar_collapsed")
  data             Json     @default("{}")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("user_preferences")
}

model SavedView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  resource  String
  name      String
  state     Json
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, userId, resource])
  @@map("saved_views")
}

// ───────────────────── Auditoria, outbox, arquivos ─────────────────────

model AuditEvent {
  id                BigInt   @id @default(autoincrement())
  tenantId          String?  @map("tenant_id") @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  actorRole         String?  @map("actor_role")
  entityType        String   @map("entity_type")
  entityId          String?  @map("entity_id") @db.Uuid
  action            String
  before            Json?
  after             Json?
  metadata          Json?
  ip                String?  @db.Inet
  userAgent         String?  @map("user_agent")
  sessionId         String?  @map("session_id") @db.Uuid
  requestId         String?  @map("request_id")
  correlationId     String?  @map("correlation_id")
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, entityType, entityId, occurredAt(sort: Desc)])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  type          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String?   @map("aggregate_id") @db.Uuid
  payload       Json
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  @@index([createdAt])
  @@map("outbox_events")
}

model FileUpload {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id") @db.Uuid
  kind           DocumentKind
  originalName   String       @map("original_name")
  declaredMime   String       @map("declared_mime")
  detectedMime   String?      @map("detected_mime")
  sizeBytes      BigInt       @map("size_bytes")
  bucket         String
  objectKey      String       @unique @map("object_key")
  multipartId    String?      @map("multipart_id")
  sha256Declared String?      @map("sha256_declared")
  sha256Actual   String?      @map("sha256_actual")
  status         UploadStatus @default(PENDING)
  scanStatus     ScanStatus   @default(PENDING) @map("scan_status")
  rejectReason   String?      @map("reject_reason")
  /// Visibilidade para Fazenda/Comprador; organizações herdadas da entidade por trigger (migration 0700).
  visibility     DocumentVisibility @default(INTERNAL)
  sellerOrgId    String?      @map("seller_org_id") @db.Uuid
  buyerOrgId     String?      @map("buyer_org_id") @db.Uuid
  idempotencyKey String       @map("idempotency_key")
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, entityType, entityId])
  @@index([status, createdAt])
  @@map("file_uploads")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─────────────────────────── Cadastros ───────────────────────────

model BusinessPartner {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  personType        PersonType   @map("person_type")
  legalName         String       @map("legal_name")
  tradeName         String?      @map("trade_name")
  document          String
  stateRegistration String?      @map("state_registration")
  email             String?
  phone             String?
  city              String?
  state             String?      @db.Char(2)
  zipCode           String?      @map("zip_code")
  address           String?
  notes             String?
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?      @map("created_by") @db.Uuid
  updatedBy         String?      @map("updated_by") @db.Uuid
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz(6)

  roles          PartnerRoleAssignment[]
  farms          Farm[]
  organizations  Organization[]
  contacts       PartnerContact[]
  carrierProfile CarrierProfile?
  drivers        Driver[]
  vehicles       Vehicle[]

  @@unique([tenantId, document])
  @@index([tenantId, legalName])
  @@map("business_partners")
}

model PartnerRoleAssignment {
  partnerId String      @map("partner_id") @db.Uuid
  role      PartnerRole
  tenantId  String      @map("tenant_id") @db.Uuid

  partner BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([partnerId, role])
  @@index([tenantId, role])
  @@map("partner_roles")
}

model PartnerContact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  name      String
  role      String?
  phone     String?
  email     String?
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  partner BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId, partnerId])
  @@map("partner_contacts")
}

model CarrierProfile {
  partnerId       String    @id @map("partner_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  rntrc           String?
